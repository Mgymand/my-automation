# ---- 実行モード ----
DRY_RUN=true                 # true の間は X に投稿しない（ログのみ）
DATA_DIR=./data              # SQLite の保存先（本番は永続ディスク）
TZ_NAME=Asia/Tokyo

# ---- DMM / FANZA アフィリエイト ----
DMM_API_ID=
DMM_AFFILIATE_ID=            # 例: yourid-990（末尾 3 桁はチャネル ID として使える）
DMM_SITE=DMM.com             # DMM.com（一般商品）。FANZA（成人向け）は X 投稿が規約上 HARD BLOCK されるため X 運用不可
DMM_SERVICE=digital
DMM_FLOOR=videoa
DMM_PAYOUT_RATE=0.20         # 報酬率の初期値。成果 CSV 取込で実測に置換される

# ---- X API（OAuth 1.0a User Context, Read and Write）----
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_ACCOUNT_NAME=main
POSTS_PER_DAY=5
MIN_POST_INTERVAL_MIN=90
LINK_IN_REPLY=true
DISCLOSURE_TEXT=【PR】
USE_PAID_PARTNERSHIP_LABEL=true

# ---- 人間確認（bootstrap が対話で設定する。規約上の禁止事項はここでは解除できない）----
# 注意: 成人向け（FANZA）商品の X 投稿は affiliate_bot/policy.py の HARD BLOCK。解除フラグは存在しません。
SENSITIVE_MEDIA_SETTING_CONFIRMED=false  # X のセンシティブメディア設定を ON にした（水着・グラビア等を扱う場合）
DMM_MEDIA_REGISTERED=false               # DMM に X アカウントを媒体登録し承認された（bootstrap が『承認済み』入力で設定）

# ---- Claude API ----
ANTHROPIC_API_KEY=
MODEL_SONNET=claude-sonnet-5
MODEL_OPUS=claude-opus-5-5
MODEL_FABLE=claude-fable-5-1
USD_JPY=150
DAILY_AI_BUDGET_JPY=300

# ---- トラッキング（bootstrap が Vercel / Cloud Run に自動構築して設定する）----
TRACKING_BASE_URL=            # 例: https://affiliate-tracking.vercel.app
TRACKING_SECRET=              # bootstrap が自動生成。リダイレクト関数と共有する HMAC 鍵
TRACKING_PORT=8400
ATTRIBUTION_WINDOW_HOURS=72
VERCEL_TOKEN=                 # 任意: トラッキングの自動デプロイ用（vercel.com/account/settings/tokens）

# ---- Human Attention Queue の通知 ----
SLACK_WEBHOOK_URL=            # 推奨。送信成功時のみ「通知済み」になる（失敗時は次回再送）
NOTIFY_CONSOLE_DELIVERY=false # stdout/ログを人間が監視している環境でのみ true（console 出力を配送成功とみなす）

# ---- X API 価格（USD）。既定は 2026-09 の公式 pay-per-use。bootstrap/週次が公式ページと照合（10% 以内は自動適用、
#      それ以上は候補として保存し `affiliate-bot pricing --apply` で人間確認後に適用。確認前は旧価格）----
X_PRICE_POST_USD=0.015
X_PRICE_POST_URL_USD=0.20
X_PRICE_READ_POST_USD=0.005
X_PRICE_OWNED_READ_USD=0.001
X_PRICE_READ_USER_USD=0.010
# LLM 価格の上書き（USD/1M tok）例: {"claude-sonnet-5":{"in":2,"out":10,"cache":0.2}}
LLM_PRICING_JSON=

# ---- 固定費 ----
INFRA_COST_MONTH_JPY=1000
OTHER_COST_MONTH_JPY=0
