# ---- 実行モード ----
DRY_RUN=true                 # true の間は X に投稿しない（ログのみ）
DATA_DIR=./data              # SQLite の保存先（本番は永続ディスク）
TZ_NAME=Asia/Tokyo

# ---- DMM / FANZA アフィリエイト ----
DMM_API_ID=
DMM_AFFILIATE_ID=            # 例: yourid-990（末尾 3 桁はチャネル ID として使える）
DMM_SITE=FANZA               # FANZA | DMM.com（DMM.com は非成人向け。X 方針上のリスクが無い）
DMM_SERVICE=digital
DMM_FLOOR=videoa
DMM_PAYOUT_RATE=0.20         # 報酬率の初期値。成果 CSV 取込で実測に置換される

# ---- X API（OAuth 1.0a User Context, Read and Write）----
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_ACCOUNT_NAME=main
POSTS_PER_DAY=5
MIN_POST_INTERVAL_MIN=90
LINK_IN_REPLY=true
DISCLOSURE_TEXT=【PR】
USE_PAID_PARTNERSHIP_LABEL=true

# ---- 人間確認ゲート（docs/COMPLIANCE.md のチェックリストを完了してから true にする）----
ADULT_ON_X_ACKNOWLEDGED=false          # X 有料パートナーシップ方針の禁止カテゴリ（成人向け商品）を理解した上で運用する
SENSITIVE_MEDIA_SETTING_CONFIRMED=false  # X のセンシティブメディア設定を ON にした
DMM_MEDIA_REGISTERED=false               # DMM に X アカウントを媒体登録し承認された

# ---- Claude API ----
ANTHROPIC_API_KEY=
MODEL_SONNET=claude-sonnet-5
MODEL_OPUS=claude-opus-5-5
MODEL_FABLE=claude-fable-5-1
USD_JPY=150
DAILY_AI_BUDGET_JPY=300

# ---- トラッキング（自前リダイレクト）----
TRACKING_BASE_URL=            # 例: https://t.example.com  未設定ならアフィリエイト URL を直接貼る（投稿単位の帰属不可）
TRACKING_PORT=8400
ATTRIBUTION_WINDOW_HOURS=72

# ---- 固定費 ----
INFRA_COST_MONTH_JPY=1000
OTHER_COST_MONTH_JPY=0
