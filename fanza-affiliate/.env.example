# ---- 実行 ----
DATA_DIR=./data
TZ_NAME=Asia/Tokyo

# ---- FANZA / DMM アフィリエイト ----
DMM_API_ID=
DMM_AFFILIATE_ID=            # 例: yourid-990（API 用は末尾 -990〜-999）
DMM_SITE=FANZA
DMM_SERVICE=digital
DMM_FLOOR=videoa
DMM_PAYOUT_RATE=0.20         # 報酬率の初期値。成果 CSV 取込で実測に置換
DMM_MEDIA_REGISTERED=false   # X アカウントを媒体登録し承認された（bootstrap が『承認済み』入力で設定）

# ---- X（READ ONLY。投稿権限は不要。無ければ指標は CSV / 手入力）----
X_BEARER_TOKEN=
X_USERNAME=                  # 自分のユーザー名（@なし）
X_ACCOUNT_NAME=main
POSTS_PER_DAY=5
MIN_POST_INTERVAL_MIN=120
DISCLOSURE_TEXT=【PR】
METRIC_MILESTONES_HOURS=24,72   # 6,24,72,168 まで指定可（X 読取費を抑えるため既定は 2 回）

# ---- Claude API ----
ANTHROPIC_API_KEY=
MODEL_SONNET=claude-sonnet-5
MODEL_OPUS=claude-opus-5-5
MODEL_FABLE=claude-fable-5-1
USD_JPY=150
DAILY_AI_BUDGET_JPY=300
# LLM 価格の上書き（USD/1M tok）例: {"claude-sonnet-5":{"in":2,"out":10,"cache":0.2}}
LLM_PRICING_JSON=

# ---- 帰属 ----
ATTRIBUTION_WINDOW_HOURS=72

# ---- Human Attention Queue の通知 ----
SLACK_WEBHOOK_URL=
NOTIFY_CONSOLE_DELIVERY=false   # stdout/ログを人間が監視している環境でのみ true

# ---- X API 読取価格（USD）。既定は 2026-09 の公式。bootstrap/週次が公式ページと照合（staged update）----
X_PRICE_READ_POST_USD=0.005
X_PRICE_OWNED_READ_USD=0.001
X_PRICE_READ_USER_USD=0.010

# ---- 固定費（月額、円）----
INFRA_COST_MONTH_JPY=0
OTHER_COST_MONTH_JPY=0

# ---- Web UI ----
WEB_PORT=8500
WEB_TOKEN=                   # 任意。設定すると ?t=TOKEN が必要
