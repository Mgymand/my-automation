# ===== 孫LOVE 環境変数 =====
# 初回起動時に管理者として登録するGoogleアカウント（必須）
ADMIN_EMAIL=you@example.com
# Googleログイン（Google Cloud Console → OAuthクライアントID(ウェブ)）。未設定なら開発用ログイン
GOOGLE_CLIENT_ID=
# セッション署名キー（未設定なら自動生成して data/.secret_key に保存）
SECRET_KEY=
# データ保存先（本番は永続ディスクを指定。未設定なら ./data）
MAGO_DATA_DIR=
# Slack Incoming Webhook（画面の設定からも入力可）
SLACK_WEBHOOK_URL=
# 通知内リンクのベースURL
APP_URL=
# 日次ダイジェスト用トークン（外部cronから /api/cron/digest?token=... を叩く）
CRON_TOKEN=
# 任意: PDF取込のAI構造化を有効化
ANTHROPIC_API_KEY=
# リバースプロキシ配下（Render/Cloud Run）では 1
TRUST_PROXY=
